# Copy this file to an untracked .env and set only non-secret local values here.
# Store real credentials only in the untracked .env file.

# Application
TEXTIFY_ENVIRONMENT=local
TEXTIFY_LOG_LEVEL=INFO
TEXTIFY_HOST=127.0.0.1
TEXTIFY_PORT=8182

# Required for API, reconciler, and worker.
# Use an externally reachable PostgreSQL database dedicated to Textify.
TEXTIFY_DATABASE_URL=postgresql+asyncpg://textify:change-me@127.0.0.1:5432/textify
TEXTIFY_MAX_OUTSTANDING_JOBS=8
TEXTIFY_JOB_QUEUE_TIMEOUT_SECONDS=20
TEXTIFY_JOB_RETENTION_SECONDS=86400

# Required for reconciler and worker. The API does not read these settings.
# A worker uses PostgreSQL claims as the authoritative Execution Attempt owner.
TEXTIFY_BROKER_URL=redis://127.0.0.1:6379/0
TEXTIFY_WORKER_CONCURRENCY=4
TEXTIFY_RECONCILER_INTERVAL_SECONDS=1.0
TEXTIFY_ATTEMPT_HEARTBEAT_SECONDS=5.0
TEXTIFY_ATTEMPT_LEASE_SECONDS=30.0

# Transcription
TEXTIFY_MAX_DURATION_SECONDS=1800
TEXTIFY_TEMPORARY_MEDIA_ROOT=/tmp/textify
TEXTIFY_WHISPER_MODEL=large-v3-turbo
TEXTIFY_WHISPER_REVISION=0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf
TEXTIFY_WHISPER_DEVICE=cuda
TEXTIFY_WHISPER_DEVICE_INDEX=0
TEXTIFY_GPU_IDENTITY=GPU-REPLACE-WITH-NVIDIA-UUID
TEXTIFY_GPU_LOCK_DIRECTORY=/tmp/textify/gpu-locks
TEXTIFY_WHISPER_COMPUTE_TYPE=float16
TEXTIFY_BEAM_SIZE=1
TEXTIFY_VAD_FILTER=true
TEXTIFY_TEMPERATURE=0.0
TEXTIFY_CONDITION_ON_PREVIOUS_TEXT=true
TEXTIFY_INITIAL_PROMPT=
TEXTIFY_TRANSCRIPTION_CONCURRENCY=2
TEXTIFY_MAX_MEDIA_BYTES=536870912
TEXTIFY_METADATA_TIMEOUT_SECONDS=30.0
TEXTIFY_AUDIO_DOWNLOAD_TIMEOUT_SECONDS=300.0
TEXTIFY_TRANSCRIPTION_TIMEOUT_SECONDS=1800.0

# Optional. Set only when Hugging Face authentication is required to load the model.
# TEXTIFY_HF_TOKEN=